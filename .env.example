FLASK_ENV=development
SECRET_KEY=change-me
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_DB=handoff
GEMINI_API_KEY=
# Verify current model names in Google AI Studio; model names are retired often.
GEMINI_MODEL=gemini-3.8-flash
# Used on the 2nd attempt if the first model fails (e.g. 404 retired model, rate limit)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_SECONDS=30
AI_MAX_ATTEMPTS=2
LOG_LEVEL=INFO
LOG_DIR=logs
SEED_ON_STARTUP=true
MAX_UPLOAD_MB=5
