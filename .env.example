FLASK_ENV=development
SECRET_KEY=change-me
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_DB=handoff
GEMINI_API_KEY=
# AI providers are tried in this order; providers without a key are skipped. Free keys: console.groq.com, cloud.cerebras.ai, aistudio.google.com
AI_PROVIDER_ORDER=groq,cerebras,gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
# Verify current model names in Google AI Studio; model names are retired often.
GEMINI_MODEL=gemini-3.8-flash
# Used on the 2nd attempt if the first model fails (e.g. 404 retired model, rate limit)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_SECONDS=30
AI_MAX_ATTEMPTS=2
LOG_LEVEL=INFO
LOG_DIR=logs
SEED_ON_STARTUP=true
MAX_UPLOAD_MB=5
